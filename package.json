{
  "name": "wlc-clipper",
  "version": "0.1.0",
  "description": "Turns a local video file and a time range into a finished 1080x1920 clip",
  "private": true,
  "type": "module",
  "bin": {
    "clipper": "./src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "setup": "node scripts/setup.js",
    "build": "vite build --config web/vite.config.js",
    "dashboard": "npm run build && node server/index.js",
    "dev:web": "vite --config web/vite.config.js"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "openai": "^7.60.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
